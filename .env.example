# ====================================================================
# Automated Code Review Tool & Software Quality System - Configuration
# ====================================================================

# Server Port
PORT=5000

# Primary AI Provider ("gemini", "openai", "groq", or "ollama")
AI_PROVIDER=gemini

# Google Gemini API Key (Optional for static-only review; required for AI/Hybrid)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional alternative for ultra-fast Llama inference)
GROQ_API_KEY=your_groq_api_key_here

# Ollama Base URL (For fully local offline LLM review)
OLLAMA_BASE_URL=http://localhost:11434/api/chat
